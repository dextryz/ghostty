font-family = Maple Mono NF CN
font-style = Light
font-family-italic = Maple Mono NF CN
font-style-italic = Thin Italic
font-size = 16
#theme = tokyonight_moon
#theme = everforest
#theme = kanso-ink
#theme = kanso-zen
#theme = kanso-mist
#theme = e-ink
#theme = e-ink-light
#theme = kanso-pearl
#theme = iceberg
#theme = rose-moon
#theme = kanagawa
#theme = catppuccin_macchiato
#theme = vague
#theme = mfd-flir
theme = solarized-mono
#theme = solarized-mono-light
#theme = mfd-flir-kanagawa
#theme = zenbones_dark
#theme = zenbones_light
background-opacity = 0.9
font-thicken = false
background-blur = true
window-padding-x = 20
window-padding-y = 20
macos-titlebar-style = tabs
mouse-hide-while-typing = true
window-inherit-working-directory = true
keybind = ctrl+t=new_tab
keybind = ctrl+h=previous_tab
keybind = alt+h=goto_split:left
keybind = alt+j=goto_split:bottom
keybind = alt+k=goto_split:top
keybind = alt+l=goto_split:right
keybind = super+enter=toggle_fullscreen

keybind = alt+shift+h=new_split:left
keybind = alt+shift+j=new_split:down
keybind = alt+shift+k=new_split:up
keybind = alt+shift+l=new_split:right
